<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Produtos</title>

<link rel="stylesheet" href="stylesheets/produtos.css">

</head>
<body>
    <%- include('components/NavBar') %>


    <% if (alerta === 'success') { %>
        <div id="status-alert" style="background-color: #2ecc71; color: white; padding: 15px; text-align: center; font-family: 'VT323', monospace; position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 9999; border-radius: 5px; box-shadow: 0 4px 15px rgba(0,0,0,0.3); min-width: 300px; transition: opacity 0.5s ease;">
            <i class="fa-solid fa-circle-check"></i> PAGAMENTO APROVADO! CHAVE ENVIADA AO E-MAIL.
        </div>

        <script>
            setTimeout(() => {
                const alertBox = document.getElementById('status-alert');
                if (alertBox) {
                    alertBox.style.opacity = "0";
                    
                    setTimeout(() => {
                        alertBox.remove();
                        const cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
                        window.history.replaceState({path: cleanUrl}, '', cleanUrl);
                    }, 500);
                }
            }, 3000);
        </script>
    <% } %>

    <h1 class="titulo" style="max-width: 980px; margin: 20px auto; padding: 20px; color: rgb(216, 29, 107)">Nossos Produtos</h1>

    <div style="max-width: 980px; margin: 20px auto; padding: 20px; background-color: #23254bff; border-radius: 10px;">
        <form action="/produtos" method="get" style="display: flex; gap: 10px; align-items: center;">
            <input type="text" name="search" placeholder="Buscar produto" value="" style="flex-grow: 1; padding: 10px; border-radius: 5px; border: none;">
            
            <select name="order" style="padding: 10px; border-radius: 5px; border: none;">
                <option value="nome_asc" <%= %>>Nome (A-Z)</option>
                <option value="nome_desc" <%= %>>Nome (Z-A)</option>
                <option value="preco_asc" <%= %>>Preço (Menor)</option>
                <option value="preco_desc" <%= %>>Preço (Maior)</option>
            </select>
            
            <button type="submit" style="padding: 10px 15px; border-radius: 5px; border: none; background-color: #ff3e98ff; color: white; cursor: pointer;">Buscar</button>
            
            <a href="/produtos" style="padding: 10px 15px; text-decoration: none; color: white;">Limpar</a>
        </form>
    </div>

    <div>
        <% if (produtos && produtos.length > 0) { %>
            <% produtos.forEach(produto => { %>
                <a href="/produto/<%= produto._id %>" class="produto">
                    <div class="imagem-produto">
                        <img src="<%= produto.imgUrl%>" alt="<%= produto.nome %>">
                    </div>
                    <div class="detalhes-produto">
                        <h2 class="titulo-produto"><%= produto.nome %></h2>
                        <p class="desc-produto"><%= produto.descricao %></p>
                        <p class="text-produto">Preço: <%= produto.preco.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>R$</p>
                        <p class="text-produto">Estoque: <strong><%= produto.quantidade %></strong></p>
                    </div>
                </a>
            <% }) %>
        <% } else { %>
            <p class="titulo-produto" style="text-align: center;">Nenhum produto encontrado.</p>
        <% } %>
    </div>

        
    <%- include('components/Footer') %>

</body>
</html>