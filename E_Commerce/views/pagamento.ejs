<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Finalizar Pagamento</title>
    <link href="https://fonts.googleapis.com/css?family=Press+Start+2P|VT323&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/pagamento.css">

</head>
<body>
    <%- include('components/NavBar') %>

    <div class="checkout-container">
        
        <div class="resumo-pedido">
            <h2 class="titulo-secao">RESUMO DO PEDIDO</h2>
            
            <% if (carrinho.length > 0) { %>
                <% carrinho.forEach(item => { %>
                    <div class="item-checkout">
                        <img src="/images/<%= item.info.imgUrl %>" alt="<%= item.info.nome %>">
                        <div style="flex-grow: 1;">
                            <h4 style="margin: 0; font-size: 22px;"><%= item.info.nome %></h4>
                            <p style="margin: 0;">Qtd: <%= item.quantidade %> x <%= item.info.preco.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></p>
                        </div>
                        <div style="font-size: 20px;">
                            <%= item.subtotal.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %>
                        </div>
                    </div>
                <% }) %>
                <div class="total-final">
                    TOTAL: <%= totalGeral.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %>
                </div>
            <% } else { %>
                <p>Nenhum item encontrado.</p>
            <% } %>
        </div>

        <div class="opcoes-pagamento">
            <h2 class="titulo-secao">PAGAMENTO</h2>
            <form action="/pagamento/efetuarPagamento" method="POST">
                <button type="submit" class="btn-pagar">CONFIRMAR E PAGAR</button>
            </form>
        </div>
    </div>

</html>