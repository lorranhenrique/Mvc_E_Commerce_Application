<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>

<link rel="stylesheet" href="stylesheets/login.css">
    
</head>
<body>
    <div class="login-container">
        <h2>Login</h2>
        <form action="/login" method="post"> 
            <label for="login-input">Email</label>
            <input type="text" id="login-input" name='email' placeholder='Digite seu email' required>
            <label for="senha-input">Senha</label>
            <input type="password" id="senha-input" name='senha' placeholder='Digite sua senha' required>
            <button type='submit'>Entrar</button>
        </form>
        <a href="/cadastro">Novo por aqui? Cadastre-se</a>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        window.scrollTo(0, 0);

        const urlParams = new URLSearchParams(window.location.search);
        const erro = urlParams.get('error');

        if (erro) {
            let mensagem = "Erro ao acessar.";
            if (erro === 'LoginError') mensagem = "login ou senha incorretos!";

            Swal.fire({
                icon: 'error',
                title: 'Erro de Login',
                text: mensagem,
                heightAuto: false,
                confirmButtonColor: '#3085d6',
            }).then(() => {
                window.history.replaceState({}, document.title, window.location.pathname);
            });
        }
    </script>


</body>
</html>