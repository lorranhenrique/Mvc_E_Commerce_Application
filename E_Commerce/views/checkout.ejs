<link rel="stylesheet" href="/stylesheets/pagamento.css">
<link rel="stylesheet" href="/stylesheets/checkout.css">

<div class="checkout-container">
    <div class="opcoes-pagamento">

        <h2 class="titulo-secao">FINALIZAR PAGAMENTO</h2>

        <div id="loading-message">
            <i class="fa-solid fa-spinner fa-spin"></i> CARREGANDO SISTEMA SEGURO...
        </div>

        <div id="paymentBrick_container"></div>

        <div id="pixel-pix-container" class="pixel-pix-container">
            <h3 class="pixel-pix-container-h3">AGUARDANDO PAGAMENTO</h3>
            <div id="qr-code-img"></div>
            <p class="pixel-pix-container-p">CÓDIGO COPIA E COLA:</p>
            <textarea id="pix-code" readonly class="pixel-pix-container-textarea"></textarea>
            <button onclick="window.location.href='/produtos?status=success'" class="btn-pagar">JÁ PAGUEI / CONCLUIR</button>
        </div>

        <div class="btn-return">
            <a href="/carrinho"><i class="fa-solid fa-arrow-left"></i> VOLTAR AO CARRINHO</a>
        </div>
    </div>
</div>

<script src="https://sdk.mercadopago.com/js/v2"></script>
<script>
    const mp = new MercadoPago("APP_USR-1621538b-f0b4-4437-818f-6f5ec3f4e64c", { locale: 'pt-BR' });
    const bricksBuilder = mp.bricks();

    const renderPaymentBrick = async (bricksBuilder) => {
        const settings = {
            initialization: {
                amount: parseFloat("<%= totalGeral %>"),
                preferenceId: "<%= preferenceId %>",
                payer: {
                    email: "<%= user.email %>",
                    firstName: "<%= user.nome %>",
                },
            },
            customization: {
                paymentMethods: {
                    ticket: "all",
                    bankTransfer: "all",
                    creditCard: "all",
                },
                visual: {
                    fontFamily: "'VT323', monospace",
                    style: { theme: 'dark' }
                },
                enableReviewStep: true,
            },
            callbacks: {
                onReady: () => {
                    document.getElementById('loading-message').style.display = 'none';
                },
                onSubmit: ({ selectedPaymentMethod, formData }) => {
                    return new Promise((resolve, reject) => {
                        fetch("/pagamento/processar", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(formData),
                        })
                        .then((response) => response.json())
                        .then((result) => {
                            if (result.id) {
                                checkPaymentStatus(result.id);
                            }
                            if (result.qr_code_base64) {
                                document.getElementById('paymentBrick_container').style.display = 'none';
                                document.getElementById('pixel-pix-container').style.display = 'block';
                                document.getElementById('qr-code-img').innerHTML = `<img src="data:image/png;base64,${result.qr_code_base64}" style="width: 200px;">`;
                                document.getElementById('pix-code').value = result.qr_code;
                            } 
                            else if (result.status === 'approved') {
                                window.location.href = "/produtos?status=success";
                            }
                            else if (result.external_resource_url) {
                                window.open(result.external_resource_url, '_blank');
                                window.location.href = "/produtos?status=pending";
                            }
                            resolve();
                        })
                        .catch((error) => {
                            console.error(error);
                            reject();
                        });
                    });
                },
                onError: (error) => {
                    console.error("Erro crítico no SDK:", error);
                },
            },
        };
        window.paymentBrickController = await bricksBuilder.create("payment", "paymentBrick_container", settings);
    };

    const checkPaymentStatus = (paymentId) => {
        const interval = setInterval(async () => {
            try {
                const response = await fetch(`/pagamento/status/${paymentId}`);
                const data = await response.json();

                if (data.status === 'approved') {
                    clearInterval(interval);
                    window.location.href = "/produtos?status=success";
                }
            } catch (err) {
                console.error("Erro ao verificar status:", err);
            }
        }, 5000);
    };

    renderPaymentBrick(bricksBuilder);
</script>