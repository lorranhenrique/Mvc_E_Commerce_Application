<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produto</title>

    <link rel="stylesheet" href="/stylesheets/produto.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

</head>
<body>
    <%- include('components/NavBar') %>


    <div class="produto-info" style="padding-top: 150px; margin-top: 120px;">

        <a href="javascript:history.back()" class="botao-retorno"><i class="fa-solid fa-arrow-left fa-xl"></i></a>

        <div class="produto-imagem">
            
            <img src="/images/<%= produto.imgUrl %>" alt="<%= produto.nome %>">
        </div>

        <div class="produto-descricao">
            <h2>Nome</h2>
            <p><%= produto.nome || 'Sem nome disponível.' %></p>

            <h2>Quantidade</h2>
            <p class="quantidade">
                <%= produto.quantidade %>
            </p>

            <h2>Preço</h2>
            <p class="preco">
                <%= produto.preco.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %>
            </p>

            <div class="produto-descricao">
                <form action="/carrinho/<%= produto._id %>" method="POST">
                    <button type="submit" class="botao-comprar">
                        Adicionar ao Carrinho
                    </button>
                </form>
            </div>
            
        </div>
    </div>



</body>
</html>